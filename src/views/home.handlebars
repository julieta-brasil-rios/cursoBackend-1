<h1>Lista de Productos</h1>

<a href="/realtimeproducts">
  <button>Administrar productos en tiempo real</button>
</a>

<div class="products">
  {{#each products}}
  <a href="/products/{{this._id}}">
    <div class="card">
      <div><strong>{{this.title}}</strong></div>
      <div class="price">$ {{this.price}}</div>
    </div>
  </a>
{{/each}}
</div>

<div class="pagination">
  {{#if hasPrevPage}}
    <a href="/products?page={{prevPage}}">
      <button>Anterior</button>
    </a>
  {{/if}}

  {{#if hasNextPage}}
    <a href="/products?page={{nextPage}}">
      <button>Siguiente</button>
    </a>
  {{/if}}
</div>